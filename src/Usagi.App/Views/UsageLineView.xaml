<UserControl x:Class="Usagi.App.Views.UsageLineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Usagi.App.Views"
             x:Name="Root" Focusable="False">
    <!-- The usage as the compact flyout and the taskbar bars show it: one line per row, with the
         parts the user picked in the user's order, and the creature among them. The parts before the
         creature make one block of rows and those after it another (Layout's Left and Right); in a
         block each part has a column, the same width in every row, so the rows line up.
         Gaps are 6 after every part (and 8 at the creature); the trailing one is taken back. -->
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,1,-6,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="C0" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="C1" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="C2" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="C3" />
                </Grid.ColumnDefinitions>
                <!-- A line of text's height, whatever the row has: a block of only bars would otherwise
                     close up to the bars' own height and lose the gap between its rows. -->
                <TextBlock Text="0" FontSize="11" Width="0" Visibility="Hidden" />
                <TextBlock Text="{Binding ShortLabel}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                           Grid.Column="{Binding Tag.LabelColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           Visibility="{Binding Tag.ShowLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{Binding SecondaryBrush, RelativeSource={RelativeSource AncestorType=views:UsageLineView}}"
                           Opacity="{Binding SecondaryOpacity, RelativeSource={RelativeSource AncestorType=views:UsageLineView}}" />
                <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Minimum="0" Maximum="100" Width="56" Height="4" Margin="0,1,6,0"
                             VerticalAlignment="Center" Style="{StaticResource UsageProgressBarStyle}"
                             Grid.Column="{Binding Tag.BarColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             Visibility="{Binding Tag.ShowBar, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}"
                             Background="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=views:UsageLineView}}" />
                <TextBlock Text="{Binding PercentageText}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                           Grid.Column="{Binding Tag.PercentageColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           Visibility="{Binding Tag.ShowPercentage, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{Binding PrimaryBrush, RelativeSource={RelativeSource AncestorType=views:UsageLineView}}" />
                <!-- When this row resets. Which edge the rows line up on depends on what it is (see ShortResetAlignment). -->
                <TextBlock Text="{Binding ShortResetText}" TextAlignment="{Binding ShortResetAlignment}" FontSize="11" VerticalAlignment="Center" Margin="2,0,6,0"
                           Grid.Column="{Binding Tag.ResetTimeColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           Visibility="{Binding Tag.ShowResetTime, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{Binding SecondaryBrush, RelativeSource={RelativeSource AncestorType=views:UsageLineView}}"
                           Opacity="{Binding SecondaryOpacity, RelativeSource={RelativeSource AncestorType=views:UsageLineView}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ItemsControl ItemsSource="{Binding Rows, ElementName=Root}" Tag="{Binding Layout.Left, ElementName=Root}"
                      ItemTemplate="{StaticResource RowTemplate}" Grid.IsSharedSizeScope="True" Focusable="False" VerticalAlignment="Center"
                      Visibility="{Binding Layout.Left.Any, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
        <ContentPresenter Grid.Column="1" Content="{Binding Mascot, ElementName=Root}" Margin="{Binding Layout.MascotMargin, ElementName=Root}"
                          VerticalAlignment="Center"
                          Visibility="{Binding Layout.ShowMascot, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl Grid.Column="2" ItemsSource="{Binding Rows, ElementName=Root}" Tag="{Binding Layout.Right, ElementName=Root}"
                      ItemTemplate="{StaticResource RowTemplate}" Grid.IsSharedSizeScope="True" Focusable="False" VerticalAlignment="Center"
                      Visibility="{Binding Layout.Right.Any, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
