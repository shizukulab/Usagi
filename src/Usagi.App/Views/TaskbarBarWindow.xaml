<Window x:Class="Usagi.App.Views.TaskbarBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Usagi.App.Views"
        TextOptions.TextFormattingMode="Display"
        Title="Usagi"
        SizeToContent="Width" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000">
    <!-- A strip laid over the taskbar, left of the notification area: one compact line per usage
         row (label, bar, percentage, time left) and the creature, of which the user picks the rows,
         the parts and their order.
         As tall as the taskbar and as wide as its content; placed by TaskbarBarController, and off
         screen until it has been. The text/track/backdrop/hover brushes are set in code-behind to
         suit the taskbar's color, which follows Windows' mode, not the app theme (or, over a
         full-screen app, to stand on their own). -->
    <Border CornerRadius="4" Margin="0,4" Padding="8,0" Cursor="Hand" MouseLeftButtonDown="OnMouseLeftButtonDown"
            MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseLeftButtonUp" LostMouseCapture="OnLostMouseCapture"
            MouseRightButtonUp="OnMouseRightButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TaskbarBarBackdropBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TaskbarBarHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!-- Every row in full, whatever the strip itself shows: what each bar is, and when it resets. -->
        <Border.ToolTip>
            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <ItemsControl ItemsSource="{Binding AllRows}" Focusable="False"
                              ItemTemplate="{StaticResource UsageRowSummaryTemplate}" />
            </ToolTip>
        </Border.ToolTip>
        <!-- The bars, and the creature among them, as the user lays them out (TaskbarLayout). -->
        <views:UsageLineView Rows="{Binding TaskbarRows}" Layout="{Binding TaskbarLayout}" VerticalAlignment="Center"
                             PrimaryBrush="{DynamicResource TaskbarBarTextBrush}" SecondaryBrush="{DynamicResource TaskbarBarTextBrush}"
                             SecondaryOpacity="0.8" TrackBrush="{DynamicResource TaskbarBarTrackBrush}">
            <views:UsageLineView.Mascot>
                <views:MascotView VerticalAlignment="Center" Style="{StaticResource MascotStyle}" />
            </views:UsageLineView.Mascot>
        </views:UsageLineView>
    </Border>
</Window>
