<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Usagi.App.Converters"
                    xmlns:loc="clr-namespace:Usagi.App.Localization"
                    xmlns:views="clr-namespace:Usagi.App.Views">
    <!-- What the pages of the settings window (Views/SettingsPages) are built from: groups of
         rows, each with a title and a description on the left and its control on the right. -->

    <!-- Setting group ("setting-group" in Obsidian): a softly tinted, rounded block of rows
         with no outline. -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- Drop-down item label, re-evaluated on every language switch (see ChoiceLabelConverter). -->
    <converters:ChoiceLabelConverter x:Key="ChoiceLabel" />
    <DataTemplate x:Key="ChoiceTemplate">
        <TextBlock>
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource ChoiceLabel}">
                    <Binding />
                    <Binding Source="{x:Static loc:Loc.Instance}" Path="[Settings_Theme]" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>
    <!-- Page heading above its group, like Obsidian's setting headings. -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="4,0,0,12" />
    </Style>
    <!-- Heading of a further group on the same page. It says what the group's rows are about,
         so their titles don't each have to. -->
    <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="4,22,0,8" />
    </Style>
    <!-- Common padding of a card row. -->
    <Style x:Key="CardRowStyle" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="16,14" />
    </Style>
    <!-- Row title (setting-item-name) and the description under it (setting-item-description). -->
    <Style x:Key="RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="RowDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <!-- Hairline between the rows of a group, inset from its edges. -->
    <Style x:Key="CardDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
    <!-- A card row that is a toggle: title and description on the left, switch on the right,
         whole row clickable. The two texts are set on the CheckBox as SettingRow.Title and
         SettingRow.Description. -->
    <Style x:Key="ToggleRowStyle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyle}">
        <Setter Property="Margin" Value="16,14" />
        <Setter Property="AutomationProperties.Name" Value="{Binding (views:SettingRow.Title), RelativeSource={RelativeSource Self}}" />
        <!-- The title is the content, so that there is content for the template below to show. -->
        <Setter Property="Content" Value="{Binding (views:SettingRow.Title), RelativeSource={RelativeSource Self}}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding}" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="{Binding (views:SettingRow.Description), RelativeSource={RelativeSource AncestorType=CheckBox}}"
                                   Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Any other card row: title and description on the left, and on the right whatever
         control the row holds. -->
    <Style TargetType="views:SettingRow">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:SettingRow">
                    <DockPanel Margin="16,14">
                        <ContentPresenter DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Segmented control (Windows 11's SelectorBar, a macOS segmented control): a row of
         RadioButtons (SegmentedButtonStyle) in a SegmentedPanel on a tinted track, the chosen one
         raised onto a card that slides from choice to choice (the panel draws it).
         For a choice of a few short options that are all always available. -->
    <Style x:Key="SegmentedTrackStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <!-- (The card under it is the SegmentedPanel's.) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A row's drop-down of ChoiceOptions, named after its row for screen readers. -->
    <Style x:Key="SettingComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="SelectedValuePath" Value="Value" />
        <Setter Property="ItemTemplate" Value="{StaticResource ChoiceTemplate}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource AncestorType=views:SettingRow}}" />
    </Style>
</ResourceDictionary>
